{
  "name": "justbetter/laravel-instagram-feed",
  "description": "Fetches the instagram feed for given authenticated profiles",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Michael Joyner",
      "email": "joyner.michael@gmail.com"
    }
  ],
  "require": {
    "php": "^8.0",
    "ext-json": "*",
    "illuminate/config": "^13.0",
    "illuminate/console": "^13.0",
    "illuminate/database": "^13.0",
    "illuminate/http": "^13.0",
    "illuminate/mail": "^13.0",
    "illuminate/support": "^13.0",
    "guzzlehttp/guzzle": "^7.0.1"
  },
  "require-dev": {
    "orchestra/testbench": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "JustBetter\\InstagramFeed\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "JustBetter\\InstagramFeed\\Tests\\": "tests"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "JustBetter\\InstagramFeed\\InstagramFeedServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  }
}
